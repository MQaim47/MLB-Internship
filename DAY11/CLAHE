import cv2
import numpy as np
import matplotlib.pyplot as plt



def calculate_histogram(image):

    histogram = np.zeros(256, dtype=np.int32)

    rows, cols = image.shape

    for i in range(rows):
        for j in range(cols):
            histogram[image[i, j]] += 1

    return histogram


def calculate_pdf(histogram):

    total_pixels = np.sum(histogram)

    return histogram / total_pixels


def calculate_cdf(pdf):

    cdf = np.zeros(256)

    cdf[0] = pdf[0]

    for i in range(1, 256):
        cdf[i] = cdf[i - 1] + pdf[i]

    return cdf


def histogram_equalization(image):

    histogram = calculate_histogram(image)

    pdf = calculate_pdf(histogram)

    cdf = calculate_cdf(pdf)

    lookup_table = np.round(
        cdf * 255
    ).astype(np.uint8)

    rows, cols = image.shape

    output = np.zeros_like(image)

    for i in range(rows):
        for j in range(cols):
            output[i, j] = lookup_table[
                image[i, j]
            ]

    return output


def apply_clahe(image):

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    return clahe.apply(image)



def show_results(
        original,
        equalized,
        clahe_image):

    hist_original = calculate_histogram(
        original
    )

    hist_equalized = calculate_histogram(
        equalized
    )

    hist_clahe = calculate_histogram(
        clahe_image
    )

    plt.figure(figsize=(15, 10))

    # Original
    plt.subplot(3, 2, 1)
    plt.imshow(original, cmap='gray')
    plt.title("Original Image")
    plt.axis("off")

    plt.subplot(3, 2, 2)
    plt.plot(hist_original)
    plt.title("Original Histogram")

    plt.subplot(3, 2, 3)
    plt.imshow(equalized, cmap='gray')
    plt.title("Histogram Equalization")
    plt.axis("off")

    plt.subplot(3, 2, 4)
    plt.plot(hist_equalized)
    plt.title("Equalized Histogram")

    plt.subplot(3, 2, 5)
    plt.imshow(clahe_image, cmap='gray')
    plt.title("CLAHE")
    plt.axis("off")

    plt.subplot(3, 2, 6)
    plt.plot(hist_clahe)
    plt.title("CLAHE Histogram")

    plt.tight_layout()
    plt.show()



image = cv2.imread(
    "images/low_contrast.jpg",
    cv2.IMREAD_GRAYSCALE
)

if image is None:
    print("Image not found")
    exit()

equalized_image = histogram_equalization(
    image
)

clahe_image = apply_clahe(
    image
)

show_results(
    image,
    equalized_image,
    clahe_image
)

print("CLAHE Comparison Completed")